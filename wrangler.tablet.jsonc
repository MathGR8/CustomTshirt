// Configuração do Cloudflare para o APP DO TABLET (pasta camisetas_tablet).
// É um segundo site, separado do configurador original (wrangler.jsonc).
// No Cloudflare, crie outro Worker a partir deste mesmo repositório e use como
// comando de deploy:  npx wrangler deploy --config wrangler.tablet.jsonc
// O "name" precisa ser IGUAL ao nome do Worker criado no painel.
{
  "name": "camisetas-tablet",
  "compatibility_date": "2026-10-01",
  "main": "./camisetas_tablet/worker/index.js",
  "assets": {
    "directory": "./camisetas_tablet",
    "binding": "ASSETS"
  },
  // Pedidos enviados pelo tablet (vistos no computador em /pedidos.html).
  // Durable Object com SQLite: incluído no plano grátis, não precisa criar nada no painel.
  "durable_objects": {
    "bindings": [{ "name": "PEDIDOS", "class_name": "Pedidos" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Pedidos"] }]
}
