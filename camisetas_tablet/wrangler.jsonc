// Configuração do Cloudflare do APP DO TABLET.
// No Cloudflare, no Worker do tablet: Configurações → Build →
//   "Diretório raiz" (Root directory / Path) = camisetas_tablet
//   "Comando de deploy" = npx wrangler deploy   (o padrão)
// O "name" precisa ser IGUAL ao nome do Worker criado no painel.
{
  "name": "camisetas-tablet",
  "compatibility_date": "2026-10-01",
  // Worker: busca de imagens na internet (/api/busca) e download (/api/imagem).
  // O resto (o app) são os arquivos estáticos da pasta.
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Pedidos enviados pelo tablet (vistos no computador em /pedidos.html).
  // Durable Object com SQLite: incluído no plano grátis, não precisa criar nada no painel.
  "durable_objects": {
    "bindings": [{ "name": "PEDIDOS", "class_name": "Pedidos" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Pedidos"] }]
}
